+import { useState } from "react";
+import { Link, useNavigate } from "react-router-dom";
+import { ArrowRight } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { Textarea } from "@/components/ui/textarea";
+import { SERVICES, type ServiceDef } from "@/config/services";
+import { saveHandoff } from "@/lib/serviceHandoff";
+
+/** Homepage: six light service cards. Input is optional; heading link works without it. */
+function ServiceCard({ s }: { s: ServiceDef }) {
+  const navigate = useNavigate();
+  const [value, setValue] = useState("");
+  const inputId = `card-${s.id}-input`;
+
+  const go = (e: React.FormEvent) => {
+    e.preventDefault();
+    const v = value.trim();
+    if (!v) {
+      navigate(s.route);
+      return;
+    }
+    const payload =
+      s.input.kind === "topic" ? { topic: v } : s.input.kind === "url" ? { carUrl: v, message: v } : { message: v };
+    const handoff = saveHandoff(s.id, payload);
+    navigate(s.route, { state: { handoff } });
+  };
+
+  return (
+    <form
+      onSubmit={go}
+      className="flex flex-col rounded-2xl border border-border bg-card p-5 shadow-sm"
+      aria-labelledby={`card-${s.id}-title`}
+      data-service-card={s.id}
+    >
+      <h2 id={`card-${s.id}-title`} className="text-lg font-bold normal-case tracking-normal">
+        <Link to={s.route} className="text-foreground hover:text-primary underline-offset-4 hover:underline">
+          {s.title}
+        </Link>
+      </h2>
+      <p className="mt-1 text-sm font-semibold text-foreground">{s.price}</p>
+      <p className="mt-2 text-sm text-muted-foreground">{s.what}</p>
+      <div className="mt-4 flex-1">
+        <label htmlFor={inputId} className="mb-1 block text-sm font-medium text-foreground">
+          {s.input.label} <span className="font-normal text-muted-foreground">(valinnainen)</span>
+        </label>
+        {s.input.kind === "topic" ? (
+          <select
+            id={inputId}
+            value={value}
+            onChange={(e) => setValue(e.target.value)}
+            className="h-11 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground"
+          >
+            <option value="">Valitse…</option>
+            {s.input.options.map((o) => (
+              <option key={o} value={o}>{o}</option>
+            ))}
+          </select>
+        ) : s.input.kind === "url" ? (
+          <Input id={inputId} type="url" inputMode="url" value={value} onChange={(e) => setValue(e.target.value)} placeholder={s.input.placeholder} maxLength={500} className="h-11" />
+        ) : (
+          <Textarea id={inputId} value={value} onChange={(e) => setValue(e.target.value)} placeholder={s.input.placeholder} maxLength={1000} rows={2} className="resize-none" />
+        )}
+      </div>
+      <Button type="submit" className="mt-4 h-11 w-full font-semibold">
+        {s.cta}
+        <ArrowRight className="ml-2 h-4 w-4" aria-hidden />
+      </Button>
+    </form>
+  );
+}
+
+const ServiceCardsHero = () => (
+  <section className="bg-background pt-28 pb-14 md:pt-32 md:pb-20" aria-labelledby="services-heading">
+    <div className="container mx-auto max-w-6xl px-4">
+      <div className="mx-auto max-w-2xl text-center">
+        <h1 id="services-heading" className="text-3xl md:text-4xl text-foreground">
+          Auto Ruotsista tai Saksasta
+        </h1>
+        <p className="mt-3 text-base md:text-lg text-muted-foreground">
+          Valitse palvelu. Voit kirjoittaa viestin tai liittää linkin valmiiksi — se siirtyy palvelusivulle vain tällä selaimella, ei osoiteriville.
+        </p>
+      </div>
+      <div className="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
+        {SERVICES.map((s) => (
+          <ServiceCard key={s.id} s={s} />
+        ))}
+      </div>
+    </div>
+  </section>
+);
+
+export default ServiceCardsHero;

