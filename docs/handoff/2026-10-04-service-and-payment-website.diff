--- /dev/null
+++ b/src/lib/serviceHandoff.ts
@@ -0,0 +1,117 @@
+/**
+ * Session-local handoff from the homepage service cards to a service page.
+ *
+ * Privacy rules (DECISION):
+ * - User text / car URL is NEVER put in the URL query string or sent to analytics.
+ * - Transport = React Router state (primary) + sessionStorage with TTL (reload/back recovery).
+ * - Each service has its own storage key → no cross-service leakage.
+ */
+export type ServiceId =
+  | "perusselvitys"
+  | "etsinta"
+  | "tuontiapu"
+  | "tuontipalvelu"
+  | "yhteys"
+  | "rahoitus";
+
+export type HandoffData = {
+  service: ServiceId;
+  message?: string;
+  carUrl?: string;
+  topic?: string;
+  ts: number;
+};
+
+export const SERVICE_IDS: ServiceId[] = ["perusselvitys", "etsinta", "tuontiapu", "tuontipalvelu", "yhteys", "rahoitus"];
+export const HANDOFF_TTL_MS = 30 * 60 * 1000;
+const KEY = (s: ServiceId) => `caars_handoff_v1:${s}`;
+const MAX_MSG = 1000;
+
+export function isServiceId(v: unknown): v is ServiceId {
+  return typeof v === "string" && (SERVICE_IDS as string[]).includes(v);
+}
+
+/** Accepts only http(s) URLs, max 500 chars. Returns normalized string or undefined. */
+export function sanitizeUrl(raw: string | undefined | null): string | undefined {
+  const s = String(raw ?? "").trim();
+  if (!s || s.length > 500) return undefined;
+  try {
+    const u = new URL(s);
+    if (u.protocol !== "https:" && u.protocol !== "http:") return undefined;
+    return u.toString();
+  } catch {
+    return undefined;
+  }
+}
+
+/** Finds the first http(s) URL inside free text. */
+export function extractUrl(text: string): string | undefined {
+  const m = String(text || "").match(/https?:\/\/[^\s<>"']+/i);
+  return m ? sanitizeUrl(m[0]) : undefined;
+}
+
+function clean(service: ServiceId, input: Partial<HandoffData>, now = Date.now()): HandoffData {
+  const message = String(input.message ?? "").trim().slice(0, MAX_MSG) || undefined;
+  const carUrl = sanitizeUrl(input.carUrl) ?? (message ? extractUrl(message) : undefined);
+  const topic = String(input.topic ?? "").trim().slice(0, 80) || undefined;
+  return { service, message, carUrl, topic, ts: now };
+}
+
+export function saveHandoff(service: ServiceId, input: Partial<HandoffData>, storage: Storage = sessionStorage): HandoffData {
+  const data = clean(service, input);
+  try {
+    storage.setItem(KEY(service), JSON.stringify(data));
+  } catch {
+    /* storage unavailable → router state still carries it */
+  }
+  return data;
+}
+
+function valid(service: ServiceId, d: unknown, now: number): HandoffData | null {
+  if (!d || typeof d !== "object") return null;
+  const h = d as HandoffData;
+  if (h.service !== service) return null; // isolation
+  if (typeof h.ts !== "number" || now - h.ts > HANDOFF_TTL_MS || h.ts > now + 60_000) return null;
+  if (!h.message && !h.carUrl && !h.topic) return null;
+  return clean(service, h, h.ts);
+}
+
+/** Router state first, then sessionStorage. Expired/foreign entries are ignored and removed. */
+export function readHandoff(
+  service: ServiceId,
+  routerState?: unknown,
+  storage: Storage = sessionStorage,
+  now = Date.now(),
+): HandoffData | null {
+  const fromState = valid(service, (routerState as { handoff?: unknown } | null)?.handoff, now);
+  if (fromState) return fromState;
+  try {
+    const raw = storage.getItem(KEY(service));
+    if (!raw) return null;
+    const v = valid(service, JSON.parse(raw), now);
+    if (!v) storage.removeItem(KEY(service));
+    return v;
+  } catch {
+    return null;
+  }
+}
+
+export function clearHandoff(service: ServiceId, storage: Storage = sessionStorage) {
+  try {
+    storage.removeItem(KEY(service));
+  } catch {
+    /* ignore */
+  }
+}
+
+/** Service id for a pathname (used by the chatbot to send explicit service context). */
+export function serviceForPath(pathname: string): ServiceId | null {
+  const p = pathname.replace(/\/+$/, "") || "/";
+  if (p === "/perusselvitys" || p === "/tilaa-perusselvitys") return "perusselvitys";
+  if (p === "/auton-etsinta") return "etsinta";
+  if (p === "/tuontiapu") return "tuontiapu";
+  if (p === "/tuontipalvelu" || p === "/auton-tuontipalvelu") return "tuontipalvelu";
+  if (p === "/yhteystiedot") return "yhteys";
+  if (p === "/rahoitus-ja-vaihtoauto") return "rahoitus";
+  return null;
+}

