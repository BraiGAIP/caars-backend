+/**
+ * Behaviour tests for the six homepage service cards (replaces the obsolete
+ * three-CTA Hero className snapshot test).
+ */
+import { describe, it, expect, beforeEach, vi } from "vitest";
+import { render, screen, fireEvent, cleanup } from "@testing-library/react";
+import { MemoryRouter, Routes, Route, useLocation } from "react-router-dom";
+import ServiceCardsHero from "@/components/ServiceCardsHero";
+import { SERVICES } from "@/config/services";
+import {
+  readHandoff,
+  saveHandoff,
+  HANDOFF_TTL_MS,
+  type ServiceId,
+} from "@/lib/serviceHandoff";
+
+function Dest({ service }: { service: ServiceId }) {
+  const loc = useLocation();
+  const h = readHandoff(service, loc.state);
+  return (
+    <div>
+      <div data-testid="path">{loc.pathname}</div>
+      <div data-testid="search">{loc.search}</div>
+      <div data-testid="hash">{loc.hash}</div>
+      <div data-testid="message">{h?.message ?? ""}</div>
+      <div data-testid="carUrl">{h?.carUrl ?? ""}</div>
+      <div data-testid="topic">{h?.topic ?? ""}</div>
+    </div>
+  );
+}
+
+const renderApp = (initial: string | { pathname: string; state?: unknown } = "/") =>
+  render(
+    <MemoryRouter initialEntries={[initial]}>
+      <Routes>
+        <Route path="/" element={<ServiceCardsHero />} />
+        {SERVICES.map((s) => (
+          <Route key={s.id} path={s.route} element={<Dest service={s.id} />} />
+        ))}
+      </Routes>
+    </MemoryRouter>,
+  );
+
+const EXPECTED: Record<ServiceId, { route: string; price: string }> = {
+  perusselvitys: { route: "/perusselvitys", price: "79 €" },
+  etsinta: { route: "/auton-etsinta", price: "79 €" },
+  tuontiapu: { route: "/tuontiapu", price: "250 €" },
+  tuontipalvelu: { route: "/tuontipalvelu", price: "Ruotsi alk. 1 290 € · Saksa alk. 1 990 €" },
+  yhteys: { route: "/yhteystiedot", price: "Maksuton" },
+  rahoitus: { route: "/rahoitus-ja-vaihtoauto", price: "Kysy tarjous" },
+};
+
+const fetchSpy = vi.fn();
+beforeEach(() => {
+  cleanup();
+  sessionStorage.clear();
+  fetchSpy.mockReset();
+  globalThis.fetch = fetchSpy as unknown as typeof fetch;
+});
+
+describe("ServiceCardsHero — six cards", () => {
+  it("renders exactly six cards with correct heading links and prices", () => {
+    const { container } = renderApp();
+    const cards = container.querySelectorAll("[data-service-card]");
+    expect(cards).toHaveLength(6);
+    for (const s of SERVICES) {
+      const card = container.querySelector(`[data-service-card="${s.id}"]`)!;
+      const link = card.querySelector("h2 a")!;
+      expect(link.getAttribute("href")).toBe(EXPECTED[s.id].route);
+      if (EXPECTED[s.id].price) expect(card.textContent).toContain(EXPECTED[s.id].price);
+      // every input has a visible label
+      const control = card.querySelector("input, textarea, select")!;
+      expect(card.querySelector(`label[for="${control.id}"]`)).not.toBeNull();
+    }
+  });
+
+  it.each(SERVICES.map((s) => [s.id, s] as const))(
+    "%s: transfers exact input with clean search/hash and survives remount",
+    (_id, s) => {
+      const { container, unmount } = renderApp();
+      const card = container.querySelector(`[data-service-card="${s.id}"]`)!;
+      const control = card.querySelector("input, textarea, select") as HTMLInputElement;
+      const value =
+        s.input.kind === "topic"
+          ? s.input.options[0]
+          : s.input.kind === "url"
+            ? "https://www.blocket.se/annons/stockholm/volvo_v60/123456"
+            : "Volvo V60 2020, budjetti 25 000 € https://www.blocket.se/annons/x/1";
+      fireEvent.change(control, { target: { value } });
+      fireEvent.submit(card);
+
+      expect(screen.getByTestId("path").textContent).toBe(s.route);
+      expect(screen.getByTestId("search").textContent).toBe("");
+      expect(screen.getByTestId("hash").textContent).toBe("");
+      if (s.input.kind === "topic") {
+        expect(screen.getByTestId("topic").textContent).toBe(value);
+      } else if (s.input.kind === "url") {
+        expect(screen.getByTestId("carUrl").textContent).toBe(value);
+      } else {
+        expect(screen.getByTestId("message").textContent).toBe(value);
+        expect(screen.getByTestId("carUrl").textContent).toBe("https://www.blocket.se/annons/x/1");
+      }
+      expect(fetchSpy).not.toHaveBeenCalled(); // no auto-send
+
+      // Remount the destination WITHOUT router state (reload) → sessionStorage recovers it.
+      unmount();
+      renderApp(s.route);
+      const field = s.input.kind === "topic" ? "topic" : s.input.kind === "url" ? "carUrl" : "message";
+      expect(screen.getByTestId(field).textContent).toBe(value);
+    },
+  );
+
+  it("heading link navigates without input and stores nothing", () => {
+    const { container } = renderApp();
+    const link = container.querySelector('[data-service-card="tuontiapu"] h2 a')!;
+    fireEvent.click(link);
+    expect(screen.getByTestId("path").textContent).toBe("/tuontiapu");
+    expect(screen.getByTestId("message").textContent).toBe("");
+    expect(sessionStorage.length).toBe(0);
+    expect(fetchSpy).not.toHaveBeenCalled();
+  });
+
+  it("empty submit navigates without input and stores nothing", () => {
+    const { container } = renderApp();
+    fireEvent.submit(container.querySelector('[data-service-card="etsinta"]')!);
+    expect(screen.getByTestId("path").textContent).toBe("/auton-etsinta");
+    expect(sessionStorage.length).toBe(0);
+  });
+});
+
+describe("serviceHandoff storage robustness", () => {
+  it("isolates services", () => {
+    saveHandoff("perusselvitys", { carUrl: "https://www.blocket.se/a/1" });
+    expect(readHandoff("etsinta")).toBeNull();
+    expect(readHandoff("perusselvitys")?.carUrl).toBe("https://www.blocket.se/a/1");
+  });
+
+  it("expires after TTL and removes the entry", () => {
+    const h = saveHandoff("tuontiapu", { message: "hei" });
+    expect(readHandoff("tuontiapu", undefined, sessionStorage, h.ts + HANDOFF_TTL_MS + 1)).toBeNull();
+    expect(sessionStorage.getItem("caars_handoff_v1:tuontiapu")).toBeNull();
+  });
+
+  it("ignores corrupt JSON without throwing", () => {
+    sessionStorage.setItem("caars_handoff_v1:yhteys", "{not json");
+    expect(() => readHandoff("yhteys")).not.toThrow();
+    expect(readHandoff("yhteys")).toBeNull();
+  });
+
+  it("rejects a foreign-service entry stored under another key", () => {
+    sessionStorage.setItem(
+      "caars_handoff_v1:rahoitus",
+      JSON.stringify({ service: "perusselvitys", message: "x", ts: Date.now() }),
+    );
+    expect(readHandoff("rahoitus")).toBeNull();
+  });
+
+  it("works when storage is unavailable (router state still carries data)", () => {
+    const broken = {
+      getItem: () => { throw new Error("denied"); },
+      setItem: () => { throw new Error("denied"); },
+      removeItem: () => { throw new Error("denied"); },
+    } as unknown as Storage;
+    const h = saveHandoff("etsinta", { message: "farmari" }, broken);
+    expect(h.message).toBe("farmari");
+    expect(readHandoff("etsinta", { handoff: h }, broken)?.message).toBe("farmari");
+    expect(readHandoff("etsinta", undefined, broken)).toBeNull();
+  });
+
+  it("drops non-http URLs", () => {
+    const h = saveHandoff("perusselvitys", { carUrl: "javascript:alert(1)" });
+    expect(h.carUrl).toBeUndefined();
+  });
+});

