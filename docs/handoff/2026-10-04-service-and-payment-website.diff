+// Durable, idempotent fulfillment for the 299 € Aloitusmaksu (commitment deposit).
+// Used by stripe-webhook (authoritative, signed) and verify-deposit (visitor page).
+// Email is sent at most once: atomic claim → send → mark sent. Failures release the
+// claim and throw so the caller can return a retryable error.
+import { safeRouteAdminEvent } from "./adminNotify.ts";
+
+export const DEPOSIT_PRODUCT = "commitment_deposit_299";
+export const CALENDLY_URL = "https://calendly.com/hans-caars/10min-konsultaatio-caars";
+const WHATSAPP_PRODUCTION_NUMBER = "358400600609";
+
+const esc = (s: string) =>
+  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
+
+// deno-lint-ignore no-explicit-any
+type Db = any;
+// deno-lint-ignore no-explicit-any
+type Session = any;
+
+export function isDepositSession(session: Session): boolean {
+  return (session?.metadata?.product || "") === DEPOSIT_PRODUCT;
+}
+
+async function sendEmail(to: string, name: string | null, idemKey: string) {
+  const key = Deno.env.get("RESEND_API_KEY");
+  if (!key) throw new Error("RESEND_API_KEY missing");
+  const greeting = name ? `Hei ${esc(name)},` : "Hei,";
+  const html = `
+    <div style="font-family:Arial,sans-serif;max-width:560px;margin:0 auto;padding:24px;color:#1a1a1a;">
+      <h1 style="color:#1a1a1a;margin:0 0 16px;font-size:22px;">Aloitusmaksu vastaanotettu</h1>
+      <p>${greeting}</p>
+      <p>Vastaanotimme 299 € aloitusmaksusi. Olemme yhteydessä viimeistään 24 tunnin kuluessa ja sovimme lyhyen konsultaation.</p>
+      <p><a href="${CALENDLY_URL}">Varaa konsultaatioaika kalenterista</a></p>
+      <p style="font-size:14px;color:#444;">Aloitusmaksu vähennetään Avaimet käteen -tuonnin loppuhinnasta.</p>
+      <p style="font-size:14px;">Kysymyksiä? Vastaa tähän viestiin tai kirjoita WhatsAppissa
+        <a href="https://wa.me/${WHATSAPP_PRODUCTION_NUMBER}">+358 400 600 609</a>.</p>
+      <p style="font-size:12px;color:#666;">Caars · Tuotekatu 13a, 21200 Raisio</p>
+    </div>`;
+  const res = await fetch("https://api.resend.com/emails", {
+    method: "POST",
+    headers: { Authorization: `Bearer ${key}`, "Content-Type": "application/json", "Idempotency-Key": idemKey },
+    body: JSON.stringify({ from: "Caars <info@caars.fi>", to: [to], subject: "Aloitusmaksu vastaanotettu – Caars", html }),
+  });
+  if (!res.ok) throw new Error(`resend_${res.status}`);
+}
+
+/** Marks the deposit paid (if session is paid) and sends confirmation once. Throws on retryable failure. */
+export async function fulfillDeposit(db: Db, session: Session): Promise<{ paid: boolean; deposit: Record<string, unknown> | null }> {
+  const depositId = session?.metadata?.deposit_id;
+  let q = db.from("commitment_deposits").select("*");
+  q = depositId ? q.eq("id", depositId) : q.eq("stripe_session_id", session.id);
+  const { data: deposit, error } = await q.maybeSingle();
+  if (error) throw new Error(`deposit lookup failed: ${error.message}`);
+  if (!deposit) return { paid: false, deposit: null };
+
+  const paid = session.payment_status === "paid";
+  const upd: Record<string, unknown> = {
+    stripe_session_id: deposit.stripe_session_id || session.id,
+    stripe_payment_intent_id: typeof session.payment_intent === "string" ? session.payment_intent : (session.payment_intent?.id ?? null),
+  };
+  if (paid) upd.payment_status = "paid";
+  else if (deposit.payment_status !== "paid") upd.payment_status = session.payment_status || "pending";
+  const { error: uErr } = await db.from("commitment_deposits").update(upd).eq("id", deposit.id);
+  if (uErr) throw new Error(`deposit update failed: ${uErr.message}`);
+  if (!paid) return { paid: false, deposit };
+
+  const { data: claimed, error: cErr } = await db.rpc("claim_deposit_confirmation", { p_deposit_id: deposit.id });
+  if (cErr) throw new Error(`deposit claim failed: ${cErr.message}`);
+  if (!claimed) return { paid: true, deposit }; // already sent or in progress elsewhere
+
+  // Order: email (Resend idempotency key dedupes retries) → admin notify → mark sent.
+  // Marking sent last means a crash/DB failure leads to a retry, never a lost confirmation.
+  try {
+    await sendEmail(deposit.customer_email, deposit.customer_name, `caars-deposit-${deposit.id}`);
+    await safeRouteAdminEvent({
+      event_type: "payment_received",
+      source: "deposit-fulfill",
+      title: "299 € aloitusmaksu maksettu",
+      summary: deposit.car_wishes ? `Toiveet: ${String(deposit.car_wishes).slice(0, 600)}` : undefined,
+      severity: "success",
+      contact: { name: deposit.customer_name || undefined, email: deposit.customer_email, phone: deposit.customer_phone || undefined },
+      fields: [{ label: "Tuote", value: "Aloitusmaksu 299 €" }],
+      links: [{ label: "Avaa admin", url: "https://caars.fi/admin" }],
+    });
+    const { error: sErr } = await db.from("commitment_deposits")
+      .update({ confirmation_email_sent_at: new Date().toISOString() })
+      .eq("id", deposit.id);
+    if (sErr) throw new Error(`deposit mark-sent failed: ${sErr.message}`);
+  } catch (e) {
+    await db.from("commitment_deposits").update({ confirmation_claimed_at: null }).eq("id", deposit.id);
+    throw e;
+  }
+  return { paid: true, deposit };
+}

