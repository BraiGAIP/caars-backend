+
+/**
+ * Plain visible summary at the top of each service page (what / who / price),
+ * plus the message/link the visitor brought from the homepage card.
+ * Optional FAQ + FAQPage JSON-LD (only for pages that don't already ship one).
+ */
+const ServiceSummary = ({ service, withFaq = false }: { service: ServiceId; withFaq?: boolean }) => {
+  const s = serviceById(service);
+  const location = useLocation();
+  const [handoff, setHandoff] = useState<HandoffData | null>(null);
+
+  useEffect(() => {
+    setHandoff(readHandoff(service, location.state));
+  }, [service, location.state]);
+
+  const faqLd = {
+    "@context": "https://schema.org",
+    "@type": "FAQPage",
