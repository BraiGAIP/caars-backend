+
+/* Hardcoded white / near-white text → readable dark text, except on coloured buttons/badges */
+html.theme-light :is([class~="text-white"], [class*="text-white/"], [class*="text-[hsl(0_0%_100%"], [class*="text-[#fff"], [class*="text-[#FFF"], .bright-text-primary):not(:is([class*="bg-primary"], [class*="bg-[#25D366]"], [class*="bg-green"], [class*="bg-destructive"], [class*="bg-cta"], [class*="bg-[hsl(25"], [class*="bg-[#F27A13]"], [class*="bg-orange"], .bright-cta, button[style*="gradient"], a[style*="gradient"])):not(:is([class*="bg-primary"], [class*="bg-[#25D366]"], [class*="bg-green"], [class*="bg-destructive"], [class*="bg-cta"], [class*="bg-[hsl(25"], [class*="bg-[#F27A13]"], [class*="bg-orange"], .bright-cta, button[style*="gradient"], a[style*="gradient"]) *) {
