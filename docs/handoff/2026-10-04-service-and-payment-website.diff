+import { useEffect } from "react";
+import { useLocation } from "react-router-dom";
+
+/** Admin/partner tools keep the dark palette; every public route uses the light one. */
+export const isAdminPath = (p: string) => /^\/(control-center|admin|market\/admin|partner)(\/|$)/.test(p);
+
+const ThemeScope = () => {
+  const { pathname } = useLocation();
+  useEffect(() => {
+    const el = document.documentElement;
+    const admin = isAdminPath(pathname);
+    el.classList.toggle("theme-dark", admin);
+    el.classList.toggle("theme-light", !admin);
+  }, [pathname]);
+  return null;
+};
+
+export default ThemeScope;

