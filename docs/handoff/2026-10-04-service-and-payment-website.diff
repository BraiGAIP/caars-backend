+// @vitest-environment node
+// (jsdom fails to load in this sandbox because the optional native "canvas" build is incomplete)
+class MemStorage { m = new Map<string,string>(); get length(){return this.m.size} clear(){this.m.clear()} getItem(k:string){return this.m.has(k)?this.m.get(k)!:null} setItem(k:string,v:string){this.m.set(k,String(v))} removeItem(k:string){this.m.delete(k)} key(i:number){return [...this.m.keys()][i]??null} }
+(globalThis as unknown as { sessionStorage: Storage }).sessionStorage = new MemStorage() as unknown as Storage;
+import { describe, it, expect, beforeEach } from "vitest";
+import { saveHandoff, readHandoff, clearHandoff, sanitizeUrl, serviceForPath, HANDOFF_TTL_MS } from "@/lib/serviceHandoff";
+
+describe("serviceHandoff", () => {
+  beforeEach(() => sessionStorage.clear());
+
+  it("round-trips via sessionStorage (reload/back recovery)", () => {
+    saveHandoff("perusselvitys", { carUrl: "https://www.blocket.se/annons/1" });
+    expect(readHandoff("perusselvitys")?.carUrl).toBe("https://www.blocket.se/annons/1");
+  });
+
+  it("prefers router state", () => {
+    const h = saveHandoff("etsinta", { message: "farmari" });
+    sessionStorage.clear();
+    expect(readHandoff("etsinta", { handoff: h })?.message).toBe("farmari");
+  });
+
+  it("isolates services (no cross-service leakage)", () => {
+    const h = saveHandoff("etsinta", { message: "salainen" });
+    expect(readHandoff("rahoitus")).toBeNull();
+    expect(readHandoff("rahoitus", { handoff: h })).toBeNull();
+  });
+
+  it("expires after TTL and removes the entry", () => {
+    saveHandoff("tuontiapu", { message: "x" });
+    expect(readHandoff("tuontiapu", undefined, sessionStorage, Date.now() + HANDOFF_TTL_MS + 1)).toBeNull();
+    expect(sessionStorage.getItem("caars_handoff_v1:tuontiapu")).toBeNull();
+  });
+
+  it("rejects non-http urls", () => {
+    expect(sanitizeUrl("javascript:alert(1)")).toBeUndefined();
+    expect(sanitizeUrl("https://mobile.de/x")).toBe("https://mobile.de/x");
+  });
+
+  it("clear removes", () => {
+    saveHandoff("yhteys", { message: "hei" });
+    clearHandoff("yhteys");
+    expect(readHandoff("yhteys")).toBeNull();
+  });
+
+  it("maps six routes", () => {
+    expect(["/perusselvitys", "/auton-etsinta", "/tuontiapu", "/tuontipalvelu", "/yhteystiedot", "/rahoitus-ja-vaihtoauto"].map(serviceForPath))
+      .toEqual(["perusselvitys", "etsinta", "tuontiapu", "tuontipalvelu", "yhteys", "rahoitus"]);
+  });
+});

