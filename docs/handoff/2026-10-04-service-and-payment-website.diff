+++ b/drizzle/migrations/0002_order_side_effect_owner_token.sql
@@ -0,0 +1,108 @@
+ALTER TABLE public.orders
+  ADD COLUMN IF NOT EXISTS side_effects_claim_token uuid,
+  ADD COLUMN IF NOT EXISTS side_effects_completed jsonb NOT NULL DEFAULT '{}'::jsonb;
+
+COMMENT ON COLUMN public.orders.side_effects_completed IS 'Per-effect completion timestamps (crm, customer_email, admin_email, capi, admin_push). Rows marked done before 2026-10-03 have no per-effect evidence: historical delivery status UNKNOWN.';
+
+-- Lease with owner token. Returns token when claimed, NULL otherwise.
+CREATE OR REPLACE FUNCTION public.claim_order_side_effects_v2(p_order_id uuid, p_stale_seconds integer DEFAULT 300)
+RETURNS uuid LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public' AS $$
+DECLARE v_token uuid := gen_random_uuid(); v_id uuid;
+BEGIN
+  UPDATE public.orders
+     SET side_effects_status = 'claimed', side_effects_claimed_at = now(),
+         side_effects_attempts = side_effects_attempts + 1, side_effects_claim_token = v_token
+   WHERE id = p_order_id
+     AND (side_effects_status = 'pending'
+          OR (side_effects_status = 'claimed' AND side_effects_claimed_at < now() - make_interval(secs => p_stale_seconds)))
+  RETURNING id INTO v_id;
+  RETURN CASE WHEN v_id IS NULL THEN NULL ELSE v_token END;
+END $$;
+
+-- Record one completed effect; only the current owner may write. Also renews the lease.
+CREATE OR REPLACE FUNCTION public.mark_order_side_effect(p_order_id uuid, p_token uuid, p_effect text)
+RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public' AS $$
+DECLARE v_id uuid;
+BEGIN
+  IF p_effect NOT IN ('crm','customer_email','admin_email','capi','admin_push','deposit') THEN
+    RAISE EXCEPTION 'invalid effect %', p_effect;
+  END IF;
+  UPDATE public.orders
+     SET side_effects_completed = side_effects_completed || jsonb_build_object(p_effect, now()),
+         side_effects_claimed_at = now()
+   WHERE id = p_order_id AND side_effects_status = 'claimed' AND side_effects_claim_token = p_token
+  RETURNING id INTO v_id;
+  RETURN v_id IS NOT NULL;
+END $$;
+
+-- Finalize (done) or release (pending) — only by the current owner.
+CREATE OR REPLACE FUNCTION public.finish_order_side_effects(p_order_id uuid, p_token uuid, p_ok boolean, p_error text DEFAULT NULL)
+RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public' AS $$
+DECLARE v_id uuid;
+BEGIN
+  UPDATE public.orders
+     SET side_effects_status = CASE WHEN p_ok THEN 'done' ELSE 'pending' END,
+         side_effects_done_at = CASE WHEN p_ok THEN now() ELSE side_effects_done_at END,
+         side_effects_last_error = CASE WHEN p_ok THEN NULL ELSE left(p_error, 500) END,
+         side_effects_claim_token = NULL
+   WHERE id = p_order_id AND side_effects_status = 'claimed' AND side_effects_claim_token = p_token
+  RETURNING id INTO v_id;
+  RETURN v_id IS NOT NULL;
+END $$;
+
+REVOKE ALL ON FUNCTION public.claim_order_side_effects_v2(uuid, integer) FROM PUBLIC, anon, authenticated;
+REVOKE ALL ON FUNCTION public.mark_order_side_effect(uuid, uuid, text) FROM PUBLIC, anon, authenticated;
+REVOKE ALL ON FUNCTION public.finish_order_side_effects(uuid, uuid, boolean, text) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.claim_order_side_effects_v2(uuid, integer) TO service_role;
+GRANT EXECUTE ON FUNCTION public.mark_order_side_effect(uuid, uuid, text) TO service_role;
+GRANT EXECUTE ON FUNCTION public.finish_order_side_effects(uuid, uuid, boolean, text) TO service_role;
+
+COMMENT ON FUNCTION public.claim_order_side_effects(uuid, integer) IS 'DEPRECATED: replaced by claim_order_side_effects_v2 (owner token).';
+
+-- Serialize first-time buyer contact resolution per normalized email.
+CREATE OR REPLACE FUNCTION public.cc_ensure_order_task(p_order_id uuid)
+ RETURNS uuid LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public'
+AS $function$
+DECLARE
+  o public.orders;
+  v_contact uuid;
+  v_case uuid;
+  v_task uuid;
+  v_email text;
+BEGIN
+  SELECT * INTO o FROM public.orders WHERE id = p_order_id;
+  IF o.id IS NULL OR o.status <> 'paid' THEN RETURN NULL; END IF;
+
+  SELECT id INTO v_task FROM public.control_center_tasks WHERE order_id = o.id;
+  IF v_task IS NOT NULL THEN RETURN v_task; END IF;
+
+  v_contact := o.contact_id;
+  v_email := lower(btrim(coalesce(o.customer_email, '')));
+  IF v_contact IS NULL AND v_email <> '' THEN
+    PERFORM pg_advisory_xact_lock(hashtextextended('crm_contact_email:' || v_email, 0));
+    SELECT id INTO v_contact FROM public.crm_contacts WHERE lower(email) = v_email ORDER BY created_at LIMIT 1;
+    IF v_contact IS NULL THEN
+      INSERT INTO public.crm_contacts (source, source_detail, full_name, email)
+      VALUES ('checkout', 'Stripe-maksu', o.customer_name, v_email)
+      RETURNING id INTO v_contact;
+    END IF;
+    UPDATE public.orders SET contact_id = v_contact WHERE id = o.id AND contact_id IS NULL;
+  END IF;
+
+  IF v_contact IS NOT NULL THEN
+    v_case := public.cc_ensure_case_for_contact(v_contact);
+  END IF;
+
+  INSERT INTO public.control_center_tasks (case_id, contact_id, order_id, title, task_type, priority, status, due_at, auto_source, metadata)
+  VALUES (v_case, v_contact, o.id,
+          'Käynnistä tilaus: ' || COALESCE(o.product_type, 'muu'),
+          'start_order', 'high', 'open', now() + interval '24 hours', 'order_paid_trigger',
+          jsonb_build_object('order_id', o.id, 'product_type', o.product_type, 'total_cents', o.total_cents))
+  ON CONFLICT (order_id) WHERE order_id IS NOT NULL DO NOTHING
+  RETURNING id INTO v_task;
+
+  IF v_task IS NULL THEN
+    SELECT id INTO v_task FROM public.control_center_tasks WHERE order_id = o.id;
+  END IF;
+  RETURN v_task;
+END $function$;

