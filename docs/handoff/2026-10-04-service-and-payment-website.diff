+ALTER TABLE public.commitment_deposits ADD COLUMN IF NOT EXISTS confirmation_claimed_at timestamptz;
+
+CREATE OR REPLACE FUNCTION public.claim_deposit_confirmation(p_deposit_id uuid, p_stale_seconds integer DEFAULT 300)
+RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public' AS $$
+DECLARE v uuid;
+BEGIN
+  UPDATE public.commitment_deposits
+     SET confirmation_claimed_at = now()
+   WHERE id = p_deposit_id
+     AND payment_status = 'paid'
+     AND confirmation_email_sent_at IS NULL
+     AND (confirmation_claimed_at IS NULL OR confirmation_claimed_at < now() - make_interval(secs => p_stale_seconds))
+  RETURNING id INTO v;
+  RETURN v IS NOT NULL;
+END $$;
+REVOKE ALL ON FUNCTION public.claim_deposit_confirmation(uuid, integer) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.claim_deposit_confirmation(uuid, integer) TO service_role;

