+          <script type="application/ld+json">{JSON.stringify(faqLd)}</script>
+        </Helmet>
+      )}
+      <div className="container mx-auto max-w-3xl px-4">
+        <div className="rounded-2xl border border-border bg-card p-5 md:p-6">
+          <p className="text-sm font-semibold text-foreground">{s.title} · {s.price}</p>
+          <p className="mt-2 text-foreground"><strong>Mitä:</strong> {s.what}</p>
+          <p className="mt-1 text-foreground"><strong>Kenelle:</strong> {s.who}</p>
+          <p className="mt-1 text-foreground"><strong>Hinta:</strong> {s.price}</p>
+
+          {handoff && (
+            <div className="mt-4 rounded-xl border border-border bg-muted p-4" data-handoff-box>
+              <div className="flex items-start justify-between gap-3">
+                <p className="text-sm font-semibold text-foreground">Toit etusivulta:</p>
+                <button
+                  type="button"
+                  aria-label="Poista tuotu viesti"
+                  className="text-muted-foreground hover:text-foreground"
+                  onClick={() => { clearHandoff(service); setHandoff(null); }}
+                >
+                  <X className="h-4 w-4" />
+                </button>
+              </div>
+              {handoff.topic && <p className="mt-1 text-sm text-foreground">Aihe: {handoff.topic}</p>}
+              {handoff.carUrl && <p className="mt-1 break-all text-sm text-foreground">Linkki: {handoff.carUrl}</p>}
+              {handoff.message && handoff.message !== handoff.carUrl && (
+                <p className="mt-1 whitespace-pre-wrap text-sm text-foreground">{handoff.message}</p>
+              )}
+              <Button
+                type="button"
+                variant="outline"
+                className="mt-3"
+                onClick={() =>
+                  openChatWithDraft(
+                    [handoff.topic && `Aihe: ${handoff.topic}`, handoff.message || handoff.carUrl].filter(Boolean).join("\n"),
