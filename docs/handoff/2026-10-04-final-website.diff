+import { render, screen, within } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { describe, expect, it } from "vitest";
+import HeroPriceExample from "@/components/HeroPriceExample";
+
+const renderExample = () =>
+  render(
+    <MemoryRouter>
+      <HeroPriceExample />
+    </MemoryRouter>,
+  );
+
+describe("HeroPriceExample", () => {
+  it("presents the illustrative cost breakdown as an accessible table", () => {
+    renderExample();
+    const table = screen.getByRole("table", { name: /havainnollinen arvio/i });
+    const rowGroups = within(table).getAllByRole("rowgroup");
+    expect(rowGroups).toHaveLength(2);
+    expect(within(table).getAllByRole("row")).toHaveLength(5);
+    expect(within(table).getAllByRole("rowheader")).toHaveLength(5);
+    expect(within(table).getAllByRole("cell")).toHaveLength(5);
+    expect(table).toHaveAttribute("role", "table");
+    expect(rowGroups.every((group) => group.getAttribute("role") === "rowgroup")).toBe(true);
+    expect(within(table).getAllByRole("row").every((row) => row.getAttribute("role") === "row")).toBe(true);
+    expect(within(table).getAllByRole("rowheader").every((header) => header.getAttribute("role") === "rowheader")).toBe(true);
+    expect(within(table).getAllByRole("cell").every((cell) => cell.getAttribute("role") === "cell")).toBe(true);
+    expect(within(table).getByRole("rowheader", { name: /auton hinta ruotsissa/i })).toBeInTheDocument();
+    expect(within(table).getByRole("rowheader", { name: /kokonaishinta suomessa/i })).toBeInTheDocument();
+    expect(within(table).getByText("n. 25 700 €")).toBeInTheDocument();
+    expect(within(table).queryByText(/maksupalvelu/i)).not.toBeInTheDocument();
+    expect(screen.getByText(/maksupalvelu 149 € on erillinen valinnainen palvelu/i)).toBeInTheDocument();
+    expect(screen.getByText(/ei sisälly tämän esimerkin noin 25 700 € kokonaishintaan/i)).toBeInTheDocument();
+  });
+
+  it("keeps calculator and pricing navigation explicit", () => {
+    renderExample();
+    expect(screen.getByRole("link", { name: /laske oman autosi tuontihinta/i })).toHaveAttribute(
+      "href",
+      "/kustannuslaskuri",
+    );
+    expect(screen.getByRole("link", { name: /katso hinnasto/i })).toHaveAttribute("href", "/hinnasto");
+  });
+});

