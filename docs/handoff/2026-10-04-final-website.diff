@@ -0,0 +1,47 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { getSessionId, SESSION_IDLE_MS, touchSession } from "@/lib/chatSession";
+
+describe("service-scoped chat sessions", () => {
+  beforeEach(() => {
+    localStorage.clear();
+    vi.useRealTimers();
+  });
+
+  it("keeps separate conversation ids for separate services", () => {
+    const background = touchSession("perusselvitys");
+    const financing = touchSession("rahoitus");
+    expect(background).not.toBe(financing);
+    expect(getSessionId(false, "perusselvitys")).toBe(background);
+    expect(getSessionId(false, "rahoitus")).toBe(financing);
+  });
+
+  it("keeps the anonymous visitor id independent of service conversations", () => {
+    touchSession("etsinta");
+    touchSession("yhteys");
+    const visitorKeys = Object.keys(localStorage).filter((key) => key === "caars_visitor_id");
+    const sessionKeys = Object.keys(localStorage).filter((key) => key.startsWith("caars_chat_session:"));
+    expect(visitorKeys).toHaveLength(1);
+    expect(sessionKeys.sort()).toEqual(["caars_chat_session:etsinta", "caars_chat_session:yhteys"]);
+  });
+
+  it("expires one service without replacing another service session", () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date("2026-10-04T06:00:00Z"));
+    const first = touchSession("perusselvitys");
+    vi.setSystemTime(new Date(Date.now() + SESSION_IDLE_MS + 1));
+    const other = touchSession("tuontiapu");
+    const renewed = getSessionId(false, "perusselvitys");
+    expect(renewed).not.toBe(first);
+    expect(getSessionId(false, "tuontiapu")).toBe(other);
+  });
+
+  it("recovers from corrupt or unavailable storage", () => {
+    localStorage.setItem("caars_chat_session:tuontipalvelu", "not-json");
+    expect(() => getSessionId(false, "tuontipalvelu")).not.toThrow();
+    const spy = vi.spyOn(Storage.prototype, "getItem").mockImplementation(() => {
+      throw new Error("storage unavailable");
+    });
+    expect(() => touchSession("yhteys")).not.toThrow();
+    spy.mockRestore();
+  });
+});

