+-- One durable fulfillment task per paid ORDER + side-effect claim (outbox) on orders.
+ALTER TABLE public.control_center_tasks ADD COLUMN IF NOT EXISTS order_id uuid REFERENCES public.orders(id) ON DELETE SET NULL;
+CREATE UNIQUE INDEX IF NOT EXISTS control_center_tasks_order_id_key ON public.control_center_tasks(order_id) WHERE order_id IS NOT NULL;
+
+ALTER TABLE public.orders
+  ADD COLUMN IF NOT EXISTS side_effects_status text NOT NULL DEFAULT 'pending',
+  ADD COLUMN IF NOT EXISTS side_effects_claimed_at timestamptz,
+  ADD COLUMN IF NOT EXISTS side_effects_done_at timestamptz,
+  ADD COLUMN IF NOT EXISTS side_effects_attempts integer NOT NULL DEFAULT 0,
+  ADD COLUMN IF NOT EXISTS side_effects_last_error text;
+
+-- Existing orders were already processed by the old webhook: mark them done so nothing re-sends.
+UPDATE public.orders SET side_effects_status = 'done', side_effects_done_at = COALESCE(side_effects_done_at, created_at)
+ WHERE side_effects_status = 'pending' AND created_at < now();
+
+-- Creates (contact if missing) + case + exactly one task for a paid order. Idempotent.
+CREATE OR REPLACE FUNCTION public.cc_ensure_order_task(p_order_id uuid)
+RETURNS uuid LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public' AS $$
+DECLARE
+  o public.orders;
+  v_contact uuid;
+  v_case uuid;
+  v_task uuid;
+BEGIN
+  SELECT * INTO o FROM public.orders WHERE id = p_order_id;
+  IF o.id IS NULL OR o.status <> 'paid' THEN RETURN NULL; END IF;
+
+  SELECT id INTO v_task FROM public.control_center_tasks WHERE order_id = o.id;
+  IF v_task IS NOT NULL THEN RETURN v_task; END IF;
+
+  v_contact := o.contact_id;
+  IF v_contact IS NULL AND NULLIF(btrim(o.customer_email), '') IS NOT NULL THEN
+    SELECT id INTO v_contact FROM public.crm_contacts WHERE lower(email) = lower(btrim(o.customer_email)) ORDER BY created_at LIMIT 1;
+    IF v_contact IS NULL THEN
+      INSERT INTO public.crm_contacts (source, source_detail, full_name, email)
+      VALUES ('checkout', 'Stripe-maksu', o.customer_name, lower(btrim(o.customer_email)))
+      RETURNING id INTO v_contact;
+    END IF;
+    UPDATE public.orders SET contact_id = v_contact WHERE id = o.id AND contact_id IS NULL;
+  END IF;
+
+  IF v_contact IS NOT NULL THEN
+    v_case := public.cc_ensure_case_for_contact(v_contact);
+  END IF;
+
+  INSERT INTO public.control_center_tasks (case_id, contact_id, order_id, title, task_type, priority, status, due_at, auto_source, metadata)
+  VALUES (v_case, v_contact, o.id,
+          'Käynnistä tilaus: ' || COALESCE(o.product_type, 'muu'),
+          'start_order', 'high', 'open', now() + interval '24 hours', 'order_paid_trigger',
+          jsonb_build_object('order_id', o.id, 'product_type', o.product_type, 'total_cents', o.total_cents))
+  ON CONFLICT (order_id) WHERE order_id IS NOT NULL DO NOTHING
+  RETURNING id INTO v_task;
+
+  IF v_task IS NULL THEN
+    SELECT id INTO v_task FROM public.control_center_tasks WHERE order_id = o.id;
+  END IF;
+  RETURN v_task;
+END $$;
+REVOKE ALL ON FUNCTION public.cc_ensure_order_task(uuid) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.cc_ensure_order_task(uuid) TO service_role;
+
+-- Trigger runs in the same transaction as the order insert: order + task commit or roll back together.
+CREATE OR REPLACE FUNCTION public.cc_trigger_order_paid()
+RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public' AS $$
+BEGIN
+  IF NEW.status = 'paid' THEN
+    PERFORM public.cc_ensure_order_task(NEW.id);
+  END IF;
+  RETURN NEW;
+END $$;
+
+-- Atomic claim of side effects (emails, admin notify, CAPI). Returns true only to one caller.
+CREATE OR REPLACE FUNCTION public.claim_order_side_effects(p_order_id uuid, p_stale_seconds integer DEFAULT 300)
+RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public' AS $$
+DECLARE v_id uuid;
+BEGIN
+  UPDATE public.orders
+     SET side_effects_status = 'claimed', side_effects_claimed_at = now(), side_effects_attempts = side_effects_attempts + 1
+   WHERE id = p_order_id
+     AND (side_effects_status = 'pending'
+          OR (side_effects_status = 'claimed' AND side_effects_claimed_at < now() - make_interval(secs => p_stale_seconds)))
+  RETURNING id INTO v_id;
+  RETURN v_id IS NOT NULL;
+END $$;
+REVOKE ALL ON FUNCTION public.claim_order_side_effects(uuid, integer) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.claim_order_side_effects(uuid, integer) TO service_role;
+
+-- Admin-only dry-run/apply: paid orders lacking a fulfillment task.
+CREATE OR REPLACE FUNCTION public.cc_reconcile_order_tasks(p_apply boolean DEFAULT false)
+RETURNS TABLE(order_id uuid, created_at timestamptz, product_type text, task_id uuid, action text)
+LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public' AS $$
+DECLARE r record;
+BEGIN
+  IF NOT public.has_role(auth.uid(), 'admin') THEN RAISE EXCEPTION 'forbidden' USING ERRCODE = '42501'; END IF;
+  FOR r IN SELECT o.id, o.created_at, o.product_type FROM public.orders o
+           WHERE o.status = 'paid' AND NOT EXISTS (SELECT 1 FROM public.control_center_tasks t WHERE t.order_id = o.id)
+           ORDER BY o.created_at LOOP
+    order_id := r.id; created_at := r.created_at; product_type := r.product_type;
+    IF p_apply THEN task_id := public.cc_ensure_order_task(r.id); action := 'created';
+    ELSE task_id := NULL; action := 'would_create'; END IF;
+    RETURN NEXT;
+  END LOOP;
+END $$;
+REVOKE ALL ON FUNCTION public.cc_reconcile_order_tasks(boolean) FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.cc_reconcile_order_tasks(boolean) TO authenticated, service_role;

